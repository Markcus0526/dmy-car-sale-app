# CarSaleMan server configuration.
#
# Copy to .env and fill in. NEVER commit a filled-in .env -- the legacy app
# shipped the SQL Server `sa` password in app.config to every workstation
# (GO_MIGRATION_PLAN.md 3.2, 11.5). That is the practice this replaces.

CARSALEMAN_ADDR=:8080
CARSALEMAN_ENV=dev
CARSALEMAN_LOG_LEVEL=debug
CARSALEMAN_SHUTDOWN_TIMEOUT=15s
CARSALEMAN_CORS_ORIGINS=http://localhost:5173

# Required when CARSALEMAN_ENV=prod. Note the connection parameters:
#   parseTime=true         -- scan DATETIME into time.Time
#   loc=Asia/Shanghai      -- the operating timezone
#   charset=utf8mb4        -- every string column is NVARCHAR in the source
# Use a least-privilege account, not root.
CARSALEMAN_MYSQL_DSN=carsaleman:CHANGEME@tcp(127.0.0.1:3306)/carsaleman?parseTime=true&loc=Asia%2FShanghai&charset=utf8mb4
